<?xml version="1.0" encoding="UTF-8"?>
<xliff version="1.2" xmlns="urn:oasis:names:tc:xliff:document:1.2">
    <file source-language="en" datatype="plaintext" original="messages" date="2026-08-12T00:00:00Z" product-name="accessible_chatbot">
        <header/>
        <body>
            <trans-unit id="widget.toggle.open">
                <source>Open chat assistant</source>
            </trans-unit>
            <trans-unit id="widget.toggle.close">
                <source>Close chat assistant</source>
            </trans-unit>
            <trans-unit id="widget.dialog.label">
                <source>Chat with %s</source>
            </trans-unit>
            <trans-unit id="widget.close">
                <source>Close chat</source>
            </trans-unit>
            <trans-unit id="widget.transparency">
                <source>Your messages are sent to an AI service so that they can be answered. They are not stored permanently.</source>
            </trans-unit>
            <trans-unit id="widget.privacy.link">
                <source>Privacy policy</source>
            </trans-unit>
            <trans-unit id="widget.log.label">
                <source>Conversation</source>
            </trans-unit>
            <trans-unit id="widget.log.hint">
                <source>Use the arrow keys down and up to move from message to message. Home goes to the first message, End to the last one.</source>
            </trans-unit>
            <trans-unit id="message.sender.user">
                <source>You:</source>
            </trans-unit>
            <trans-unit id="message.sender.bot">
                <source>%s:</source>
            </trans-unit>
            <trans-unit id="message.greeting">
                <source>Hello! I am %s, the assistant for this website. I answer questions about the content of this website and I can take you to the right page.</source>
            </trans-unit>
            <trans-unit id="status.typing">
                <source>%s is writing an answer …</source>
            </trans-unit>
            <trans-unit id="status.newanswer">
                <source>New answer from %s. You can read it in the conversation.</source>
            </trans-unit>
            <trans-unit id="error.empty">
                <source>Please write a message first.</source>
            </trans-unit>
            <trans-unit id="form.input.label">
                <source>Your message</source>
            </trans-unit>
            <trans-unit id="form.send">
                <source>Send</source>
            </trans-unit>
            <trans-unit id="mic.label">
                <source>Voice input</source>
            </trans-unit>
            <trans-unit id="mic.status.listening">
                <source>I am listening …</source>
            </trans-unit>
            <trans-unit id="mic.status.recognized">
                <source>Text recognised. Please check it and press Send.</source>
            </trans-unit>
            <trans-unit id="mic.status.stopped">
                <source>Voice input stopped.</source>
            </trans-unit>
            <trans-unit id="mic.status.nospeech">
                <source>I did not hear anything. Please try again.</source>
            </trans-unit>
            <trans-unit id="mic.status.denied">
                <source>Access to the microphone was not allowed. Please allow it in your browser.</source>
            </trans-unit>
            <trans-unit id="mic.status.error">
                <source>Voice input did not work. Please type your message instead.</source>
            </trans-unit>
            <trans-unit id="mic.status.unavailable">
                <source>Voice input does not work here. Your browser does not support it, or this page is not using a secure connection. Please type your message instead.</source>
            </trans-unit>
            <trans-unit id="option.genderstyle.legend">
                <source>Wording of the answers</source>
            </trans-unit>
            <trans-unit id="option.genderstyle.neutral">
                <source>Word it without gender</source>
            </trans-unit>
            <trans-unit id="option.genderstyle.pair">
                <source>Write out both forms</source>
            </trans-unit>
            <trans-unit id="option.genderstyle.asterisk">
                <source>Short form with an asterisk</source>
            </trans-unit>
            <trans-unit id="option.genderstyle.hint">
                <source>This setting changes how the assistant words its answers.</source>
            </trans-unit>
            <trans-unit id="error.request">
                <source>The assistant cannot be reached at the moment. Please try again in a moment.</source>
            </trans-unit>
            <trans-unit id="mic.hint">
                <source>Note: your browser sends the recording to its own speech recognition service. You can also type your message instead.</source>
            </trans-unit>
            <trans-unit id="mic.hint.local">
                <source>Note: your browser recognises your speech on this device. Nothing is sent anywhere for this. You can also type your message instead.</source>
            </trans-unit>
            <trans-unit id="message.sender.system">
                <source>Note:</source>
            </trans-unit>
            <trans-unit id="error.offline">
                <source>You seem to be offline. Please check your internet connection and send the message again.</source>
            </trans-unit>
            <trans-unit id="error.timeout">
                <source>The answer is taking too long. Please send your message again.</source>
            </trans-unit>
            <trans-unit id="error.contactlink">
                <source>Go to the contact page</source>
            </trans-unit>
            <trans-unit id="error.ratelimit">
                <source>You have sent many messages in a short time. Please wait a moment, then it will work again.</source>
            </trans-unit>
            <trans-unit id="error.ratelimit.day">
                <source>You have already sent many messages today. Please try again tomorrow.</source>
            </trans-unit>
            <trans-unit id="error.invalidrequest">
                <source>Your message could not be processed. Please write a shorter message and try again.</source>
            </trans-unit>
            <trans-unit id="error.notconfigured">
                <source>The assistant is not set up yet. Please tell the operator of this website.</source>
            </trans-unit>
            <trans-unit id="error.busy">
                <source>The assistant has a lot to do right now. Please try again in a few minutes.</source>
            </trans-unit>
            <trans-unit id="error.blocked">
                <source>I cannot answer this question. Please ask me something about this website.</source>
            </trans-unit>
            <trans-unit id="error.unavailable">
                <source>The assistant cannot be reached at the moment. Please try again later.</source>
            </trans-unit>
            <trans-unit id="error.forbidden">
                <source>This request was not allowed. Please reload the page and try again.</source>
            </trans-unit>
            <trans-unit id="message.sources.one">
                <source>Link to read more:</source>
            </trans-unit>
            <trans-unit id="message.sources.many">
                <source>Links to read more:</source>
            </trans-unit>
            <trans-unit id="message.contacthint">
                <source>Maybe the contact page can help you:</source>
            </trans-unit>
            <trans-unit id="message.navigate.button">
                <source>Go to the page "%s" now</source>
            </trans-unit>
            <trans-unit id="message.navigate.arrived">
                <source>The page "%s" is now open.</source>
            </trans-unit>
            <trans-unit id="message.clarify.intro">
                <source>Please choose:</source>
            </trans-unit>
            <trans-unit id="message.clarify.option">
                <source>I mean: %s</source>
            </trans-unit>
            <trans-unit id="starter.intro">
                <source>You can ask me these questions, for example:</source>
            </trans-unit>
            <trans-unit id="widget.contact">
                <source>Contact a person</source>
            </trans-unit>
            <trans-unit id="widget.newconversation">
                <source>Start a new conversation</source>
            </trans-unit>
            <trans-unit id="widget.newconversation.question">
                <source>Do you really want to delete this conversation? Then everything starts from the beginning.</source>
            </trans-unit>
            <trans-unit id="widget.newconversation.confirm">
                <source>Yes, delete the conversation</source>
            </trans-unit>
            <trans-unit id="widget.newconversation.cancel">
                <source>No, keep the conversation</source>
            </trans-unit>
            <trans-unit id="status.conversationreset">
                <source>The conversation was deleted. You can start again now.</source>
            </trans-unit>
            <trans-unit id="form.cancel">
                <source>Cancel the answer</source>
            </trans-unit>
            <trans-unit id="status.cancelled">
                <source>The answer was cancelled. You can ask again at any time.</source>
            </trans-unit>
            <trans-unit id="status.contextlimit">
                <source>This conversation is getting long. I only keep the last 10 messages in mind. Older messages are still here to read, but I no longer use them for my answers.</source>
            </trans-unit>
            <trans-unit id="readaloud.start">
                <source>Read the answer aloud</source>
            </trans-unit>
            <trans-unit id="readaloud.stop">
                <source>Stop reading aloud</source>
            </trans-unit>
            <trans-unit id="readaloud.status.stopped">
                <source>Reading aloud stopped.</source>
            </trans-unit>
        </body>
    </file>
</xliff>
