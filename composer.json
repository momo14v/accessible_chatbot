{
	"name": "extension14v/accessible-chatbot",
	"description": "Barrierefreier Chatbot für TYPO3: beantwortet Fragen ausschließlich aus sichtbaren Website-Inhalten und navigiert Nutzer auf Wunsch (WCAG 2.1 AA).",
	"type": "typo3-cms-extension",
	"license": "proprietary",
	"authors": [
		{
			"name": "Momo Trenz",
			"email": "mt@14v.de",
			"role": "Developer"
		}
	],
	"require": {
		"php": ">=8.2",
		"typo3/cms-core": "^13.4 || ^14.0",
		"typo3/cms-backend": "^13.4 || ^14.0",
		"typo3/cms-frontend": "^13.4 || ^14.0"
	},
	"autoload": {
		"psr-4": {
			"Extension14v\\AccessibleChatbot\\": "Classes/"
		}
	},
	"extra": {
		"typo3/cms": {
			"extension-key": "accessible_chatbot"
		}
	}
}
