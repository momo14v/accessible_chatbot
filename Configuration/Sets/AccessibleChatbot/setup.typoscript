# EXT:accessible_chatbot - Site Set "Barrierefreier Chatbot"
#
# TYPO3 laedt diese Datei automatisch, sobald die Site das Set
# extension14v/accessible-chatbot in ihren dependencies auffuehrt.
#
# Die eigentliche Widget-Konfiguration steht nur EINMAL in Widget.typoscript
# und wird von beiden Einbindungswegen geladen.

@import 'EXT:accessible_chatbot/Configuration/TypoScript/Widget.typoscript'
